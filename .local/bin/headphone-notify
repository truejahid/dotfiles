#!/usr/bin/env bash

SINK="alsa_output.pci-0000_03_00.6.analog-stereo"
last=""

check_headphones() {
    sleep 0.2

    port=$(pactl list sinks | awk -v sink="$SINK" '
        $1 == "Name:" { found = ($2 == sink) }
        found && $1 == "Active" && $2 == "Port:" {
            print $3
            exit
        }
    ')

    case "$port" in
        analog-output-headphones)
            current="connected"
            ;;
        analog-output-speaker)
            current="disconnected"
            ;;
        *)
            return
            ;;
    esac

    if [[ "$current" != "$last" ]]; then
        if [[ "$current" == "connected" ]]; then
            notify-send "Headphones connected" "Wired headphones connected."
        else
            notify-send "Headphones disconnected" "Wired headphones disconnected."
        fi
        last="$current"
    fi
}

check_headphones

pactl subscribe | while IFS= read -r event; do
    case "$event" in
        *"on sink "*)
            check_headphones
            ;;
    esac
done
