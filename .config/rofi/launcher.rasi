configuration {
    show-icons: false;
    drun-display-format: "{name}";
    disable-history: true;
}

* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: #888888;
}

window {
    location: center;
    anchor: center;
    width: 350px;
    border: 1px;
    border-color: #ffffff;
    border-radius: 0px;
    padding: 0px;
    background-color: #000000;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 0px;
    background-color: transparent;
}

inputbar {
    children: [ entry ];
    padding: 12px 19px 4px 19px;
    border: 0px;
    background-color: transparent;
}

entry {
    placeholder: "Search";
    placeholder-color: #888888;
    text-color: #ffffff;
    background-color: transparent;
    cursor-color: #ffffff;
    padding: 2px 0px;
}

listview {
    columns: 1;
    lines: 11;
    dynamic: false;
    fixed-height: true;
    scrollbar: false;
    spacing: 2px;
    padding: 4px 0px 12px 0px;
    require-input: false;
    background-color: transparent;
}

element {
    children: [ element-text ];
    padding: 4px 19px;
    background-color: transparent;
    text-color: #888888;
}

element selected.normal {
    background-color: #1F1F1F;
    text-color: #CCCCCC;
}

element-text {
    text-color: inherit;
    background-color: transparent;
    highlight: none;
}
