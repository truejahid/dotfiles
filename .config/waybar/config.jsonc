{
  "layer": "top",
  "position": "top",
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [],

  "modules-right": [
    "network",
    "memory",
    "power-profiles-daemon",
    "battery",
    "clock#date",
    "clock#time"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "tooltip": false,
    "sort-by": "number",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },

  "memory": {
    "interval": 3,
    "format": "{used:0.1f}",
    "tooltip": true,
    "tooltip-format": "{used:0.2f} | {total:0.2f} GiB"
  },

  "network": {
    "interval": 3,
    "format": "0",
    "format-wifi": "1",
    "format-ethernet": "2",
    "format-linked": "0",
    "format-disconnected": "0",
    "format-disabled": "0",
    "tooltip": true,
    "tooltip-format": "Network status",
    "tooltip-format-wifi": "{essid} {signalStrength}",
    "tooltip-format-ethernet": "Ethernet connected",
    "tooltip-format-disconnected": "No network connection",
    "tooltip-format-disabled": "Wi-Fi disabled"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip": true,
    "tooltip-format": "{profile}",
    "format-icons": {
      "power-saver": "0",
      "balanced": "1",
      "performance": "2"
    }
  },

  "battery": {
    "interval": 1,
    "format": "{capacity}",
    "tooltip": true,
    "tooltip-format-charging": "Charging",
    "tooltip-format-discharging": "Discharging",
    "tooltip-format-full": "Full",

    "states": {
      "warning": 20,
      "critical": 10
    },

    "events": {
      "on-discharging-warning": "notify-send 'Low battery' 'Battery is at or below 20%.'",
      "on-discharging-critical": "notify-send -u critical 'Battery critical' 'Battery is at or below 10%.\nHibernating soon.'"
    }
  },

  "clock#date": {
    "format": "[ {:%d}",
    "tooltip": false,
  },

  "clock#time": {
    "format": "{:%H:%M} ]",
    "tooltip": false,
  },
}
